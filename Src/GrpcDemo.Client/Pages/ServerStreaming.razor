@page "/server-stream"
@using Grpc.Core
@using GrpcDemo.Contracts
@inject AccountService.AccountServiceClient Grpc

<section class="info">
    <span class="section-kicker">الگوی Server Streaming</span>
    <h2>Server Streaming</h2>
    <ul>
        <li>کلاینت <strong>یک</strong> درخواست می‌فرستد</li>
        <li>سرور چند پیام را <strong>پشت‌سرهم</strong> روی همان تماس می‌فرستد</li>
        <li>در سرور بین هر تراکنش حدود <strong>۱.۵ ثانیه</strong> فاصله است (<code>Task.Delay</code> در <code>AccountGrpcService.StreamTransactions</code>)</li>
        <li>این Delay فقط برای دموست تا جریان استریم روی لاگ دیده شود — در پروداکشن معمولاً از I/O واقعی می‌آید</li>
        <li>متد: <code>StreamTransactions</code></li>
    </ul>
</section>

<section class="card">
    <span class="section-kicker">اجرا</span>
    <h2>اجرای دمو</h2>
    <label>شماره حساب</label>
    <input @bind="accountNumber" />
    <label>تعداد پیام‌های استریم (۱ تا ۸)</label>
    <input type="number" @bind="streamLimit" min="1" max="8" />
    <div class="actions">
        <button disabled="@busy" @onclick="StreamAsync">شروع استریم سرور</button>
        <button class="secondary" @onclick="ClearLog">پاک کردن لاگ</button>
    </div>
</section>

<section class="log-card">
    <h2>لاگ زنده (هر خط ≈ ۱.۵ ثانیه فاصله)</h2>
    <pre class="log">@string.Join("\n", logs)</pre>
</section>

@code {
    private string accountNumber = "1001";
    private int streamLimit = 4;
    private bool busy;
    private readonly List<string> logs = new();

    private async Task StreamAsync()
    {
        if (busy) return;
        busy = true;
        try
        {
            Log($"→ یک درخواست با Limit={streamLimit} ارسال شد؛ منتظر پیام‌های سرور...");
            await InvokeAsync(StateHasChanged);

            using var call = Grpc.StreamTransactions(new StreamTransactionsRequest
            {
                AccountNumber = accountNumber,
                Limit = streamLimit
            });

            var index = 0;
            await foreach (var tx in call.ResponseStream.ReadAllAsync())
            {
                index++;
                Log($"← پیام #{index}: [{tx.Type}] {tx.Amount:N0} — {tx.Description}");
                await InvokeAsync(StateHasChanged);
            }

            Log("استریم سرور تمام شد.");
        }
        catch (RpcException ex)
        {
            Log($"خطا: {ex.StatusCode} — {ex.Status.Detail}");
        }
        finally
        {
            busy = false;
        }
    }

    private void Log(string message) =>
        logs.Insert(0, $"[{DateTime.Now:HH:mm:ss}] {message}");

    private void ClearLog() => logs.Clear();
}
